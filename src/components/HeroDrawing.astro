---
/**
 * A technical drawing of a browser window with the three products annotated:
 * 01 the side-panel tree (Arbor), 02 the address bar rewrite (Reroute),
 * 03 cookies swept out of the frame (CookieSweep).
 */
---

<svg
  class="drawing"
  viewBox="0 0 640 460"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  role="img"
  aria-labelledby="drawing-title"
>
  <title id="drawing-title">
    Technical drawing of a browser window annotated with Arbor, Reroute and CookieSweep.
  </title>

  <!-- dimension line, top -->
  <g class="dim">
    <path d="M120 22 H560" />
    <path d="M120 16 V28 M560 16 V28" />
    <text x="340" y="14" text-anchor="middle">BROWSER WINDOW</text>
  </g>

  <!-- window frame -->
  <g class="frame">
    <rect x="120" y="40" width="440" height="330" rx="8" pathLength="1" />
    <path d="M120 78 H560" pathLength="1" />
    <path d="M140 78 V58 Q140 52 146 52 H200 Q206 52 206 58 V78" pathLength="1" />
    <path d="M214 78 V58 Q214 52 220 52 H274 Q280 52 280 58 V78" pathLength="1" class="faint" />
    <path d="M288 78 V58 Q288 52 294 52 H348 Q354 52 354 58 V78" pathLength="1" class="faint" />
    <rect x="132" y="88" width="416" height="22" rx="11" pathLength="1" />
    <path d="M420 120 V370" pathLength="1" />
  </g>

  <!-- page content placeholders -->
  <g class="faint">
    <path d="M140 140 H380 M140 156 H340 M140 172 H360 M140 204 H300 M140 220 H380 M140 236 H320" pathLength="1" />
    <rect x="140" y="260" width="240" height="90" rx="2" pathLength="1" />
  </g>

  <!-- 01 side-panel tree -->
  <g class="tree">
    <circle cx="442" cy="136" r="3.5" pathLength="1" />
    <path d="M442 140 V330" pathLength="1" />
    <path d="M442 160 H462" pathLength="1" />
    <path d="M462 160 H480 M462 184 H480 M462 208 H480" pathLength="1" />
    <path d="M462 160 V208" pathLength="1" />
    <circle cx="486" cy="160" r="3" pathLength="1" />
    <circle cx="486" cy="184" r="3" pathLength="1" />
    <circle cx="486" cy="208" r="3" pathLength="1" />
    <path d="M492 160 H536 M492 184 H524 M492 208 H540" pathLength="1" class="faint" />
    <path d="M442 244 H462" pathLength="1" />
    <path d="M462 244 H480 M462 268 H480" pathLength="1" />
    <path d="M462 244 V268" pathLength="1" />
    <circle cx="486" cy="244" r="3" pathLength="1" />
    <circle cx="486" cy="268" r="3" pathLength="1" />
    <path d="M492 244 H530 M492 268 H540" pathLength="1" class="faint" />
    <path d="M442 304 H462" pathLength="1" />
    <circle cx="486" cy="304" r="3" pathLength="1" />
    <path d="M462 304 H480 M492 304 H528" pathLength="1" class="faint" />
    <path d="M500 226 H544 L548 232 L544 238 H500 Z" pathLength="1" class="accent" />
  </g>

  <!-- 02 url rewrite -->
  <g class="url">
    <text x="146" y="103.5">https://example.com/a?utm_source=x&amp;fbclid=y</text>
    <path d="M304 99 H344" class="strike accent" pathLength="1" />
    <path d="M356 99 H396" class="strike accent" pathLength="1" />
  </g>

  <!-- 03 cookies leaving -->
  <g class="cookies">
    <circle cx="94" cy="300" r="7" pathLength="1" />
    <circle cx="66" cy="326" r="5" pathLength="1" />
    <circle cx="84" cy="352" r="6" pathLength="1" />
    <circle cx="48" cy="372" r="4" pathLength="1" />
    <path d="M120 296 L108 300 M120 322 L76 328 M120 348 L96 352 M120 368 L58 372" pathLength="1" class="faint" />
  </g>

  <!-- callouts -->
  <g class="callout">
    <path d="M486 136 H600 V128" />
    <text x="604" y="132" text-anchor="start" class="num">01</text>
    <text x="604" y="146" text-anchor="start">ARBOR</text>
  </g>
  <g class="callout">
    <path d="M350 88 V60 H600" />
    <text x="604" y="56" text-anchor="start" class="num">02</text>
    <text x="604" y="70" text-anchor="start">REROUTE</text>
  </g>
  <g class="callout">
    <path d="M48 376 V414 H120" />
    <text x="128" y="410" text-anchor="start" class="num">03</text>
    <text x="128" y="424" text-anchor="start">COOKIESWEEP</text>
  </g>

  <!-- dimension line, side -->
  <g class="dim">
    <path d="M598 180 V370" />
    <path d="M592 180 H604 M592 370 H604" />
    <text x="0" y="0" transform="translate(616 275) rotate(90)" text-anchor="middle">SIDE PANEL</text>
  </g>

  <!-- sheet meta -->
  <g class="meta">
    <text x="120" y="446">BROWSERFORGE / SHEET 1 OF 1</text>
    <text x="560" y="446" text-anchor="end">SCALE NTS / REV A</text>
  </g>
</svg>

<style>
  .drawing {
    width: 100%;
    height: auto;
    color: var(--ink);
    overflow: visible;
  }
  text {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.08em;
    fill: var(--ink-3);
    stroke: none;
  }
  .num {
    fill: var(--ink);
    font-size: 12px;
  }
  .url text {
    font-size: 8.5px;
    fill: var(--ink-2);
    letter-spacing: 0;
  }
  .faint {
    opacity: 0.32;
  }
  .frame rect {
    stroke-width: 1.5;
  }
  .accent {
    stroke: var(--accent);
  }
  .strike {
    stroke-width: 1.75;
  }
  .dim path,
  .callout path {
    stroke: var(--ink-3);
    stroke-dasharray: 3 3;
  }
  .meta text {
    font-size: 8px;
  }
  .tree circle,
  .cookies circle {
    fill: var(--paper);
  }

  /* draw-in on load */
  [pathLength] {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 1.4s var(--ease-out) forwards;
  }
  .frame [pathLength] {
    animation-delay: 0.1s;
  }
  .tree [pathLength] {
    animation-delay: 0.7s;
  }
  .url [pathLength] {
    animation-delay: 1s;
  }
  .cookies [pathLength] {
    animation-delay: 1.1s;
  }
  text,
  .dim path,
  .callout path {
    opacity: 0;
    animation: fadein 0.6s ease 1.5s forwards;
  }
  .faint text {
    opacity: 0;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes fadein {
    to {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [pathLength] {
      animation: none;
      stroke-dasharray: none;
      stroke-dashoffset: 0;
    }
    text,
    .dim path,
    .callout path {
      opacity: 1;
      animation: none;
    }
    .dim path,
    .callout path {
      stroke-dasharray: 3 3;
    }
  }
</style>
