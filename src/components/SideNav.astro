---
interface Props {
  title?: string;
  items: { href: string; label: string; current?: boolean }[];
}
const { title = 'Contents', items } = Astro.props;
---

<nav class="side-nav" aria-label={title}>
  <span class="mono">{title}</span>
  <ol>
    {
      items.map((it) => (
        <li>
          <a href={it.href} aria-current={it.current ? 'page' : undefined}>
            {it.label}
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .side-nav {
    border-top: 1px solid var(--rule-strong);
    padding-top: 0.9rem;
  }
  ol {
    list-style: none;
    margin-top: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    counter-reset: n;
  }
  li {
    counter-increment: n;
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    font-size: 0.9rem;
  }
  li::before {
    content: counter(n, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ink-3);
  }
  a {
    text-decoration: none;
    color: var(--ink-2);
  }
  a:hover,
  a[aria-current='page'] {
    color: var(--ink);
    text-decoration: underline;
  }
</style>
