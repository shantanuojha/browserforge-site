---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { abs, type LinkMode } from '../lib/links';

/**
 * Layout for legal pages (privacy, terms, support).
 *
 * Pages that only ever live on the landing host use relative links (the
 * default). Product privacy policies are served from a product subdomain, so
 * they pass `mode="absolute"` and their own canonical URL.
 */
interface Props {
  title: string;
  description: string;
  /** Path on the landing host; used for the canonical URL unless `canonical` is set. */
  path: string;
  /** Absolute canonical URL when the page is served from another host. */
  canonical?: string;
  mode?: LinkMode;
  kicker?: string;
  effective?: string;
  current?: string;
  noindex?: boolean;
}
const {
  title,
  description,
  path,
  canonical = abs(path),
  mode = 'relative',
  kicker,
  effective,
  current,
  noindex = false,
} = Astro.props;
---

<Base title={title} description={description} canonical={canonical} ogType="article" noindex={noindex}>
  <Header mode={mode} current={current} />
  <main id="main" class="container legal">
    <header class="head">
      {kicker && <p class="label reveal" style="--i: 0">{kicker}</p>}
      <h1 class="reveal" style="--i: 1">{title}</h1>
      <p class="lede reveal" style="--i: 2">{description}</p>
      {
        effective && (
          <p class="mono eff reveal" style="--i: 3">
            Effective <time datetime={effective}>{effective}</time>
          </p>
        )
      }
    </header>
    <div class="layout">
      <div class="side">
        <slot name="aside" />
      </div>
      <article class="prose">
        <slot />
      </article>
    </div>
  </main>
  <Footer mode={mode} />
</Base>

<style>
  .legal {
    padding-block: clamp(2.5rem, 6vw, 5rem) 0;
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-bottom: clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--rule);
  }
  h1 {
    font-size: clamp(2.5rem, 5.5vw, 4.5rem);
    max-width: 20ch;
  }
  .lede {
    color: var(--ink-2);
    font-size: 1.125rem;
    max-width: 60ch;
  }
  .eff {
    margin-top: 0.25rem;
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem 3rem;
    padding-top: clamp(2rem, 4vw, 3.5rem);
  }
  .layout > * {
    min-width: 0;
  }
  @media (min-width: 880px) {
    .layout {
      grid-template-columns: minmax(200px, 1fr) minmax(0, 3fr);
    }
  }
  .side {
    align-self: start;
    position: sticky;
    top: 5.5rem;
  }
  .side:empty {
    display: none;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
</style>
