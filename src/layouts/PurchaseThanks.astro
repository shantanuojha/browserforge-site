---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProductIcon from '../components/ProductIcon.astro';
import { CONTACT_EMAIL, POLAR_CUSTOMER_PORTAL_URL, PRODUCT_LINKS } from '../config';
import { productHome, supportUrl } from '../lib/links';
import type { Product } from '../data/products';

/**
 * Post-purchase page. Polar's checkout "Success URL" for each Pro product
 * points at `https://<slug>.shantanuojha.com/thanks?checkout_id={CHECKOUT_ID}`;
 * the product-host catch-all rewrite in `vercel.json` serves the file built at
 * `/<slug>/thanks`. Every outbound link is absolute because the page lives on
 * the product host. The page is `noindex` and makes no network calls of its
 * own; the checkout reference is read from the query string in the browser
 * purely for display.
 */
interface Props {
  product: Product;
}
const { product: p } = Astro.props;

const canonical = `${productHome(p.slug)}thanks`;
const portalUrl = POLAR_CUSTOMER_PORTAL_URL || 'https://polar.sh/browserforge/portal';
const links = PRODUCT_LINKS[p.slug];
const title = `Thanks for buying ${p.name} Pro`;
const description = `How to find and activate your ${p.name} Pro licence key.`;
---

<Base
  title={title}
  description={description}
  canonical={canonical}
  ogImage={`/og/${p.slug}.png`}
  bodyClass={`theme-${p.slug}`}
  noindex
>
  <Header mode="absolute" product={p} current={p.slug} />

  <main id="main" class="container thanks" style={`--c: var(--${p.slug})`}>
    <header class="head">
      <p class="label reveal" style="--i: 0">{p.name} / Pro</p>
      <h1 class="reveal" style="--i: 1">
        <ProductIcon slug={p.slug} size={48} class="icon" />
        <span>Thanks for buying {p.name} Pro.</span>
      </h1>
      <p class="lede reveal" style="--i: 2">
        Your payment went through. Three short steps and Pro is on.
      </p>
      <p class="mono ref reveal" id="order-ref" hidden style="--i: 3">
        Order reference: <span id="order-ref-value"></span>
      </p>
    </header>

    <ol class="steps reveal" style="--i: 3">
      <li>
        <strong>Find your licence key.</strong>
        <p>
          It is shown on the confirmation page you just left and in the email from Polar with the subject
          &ldquo;Thank you for your purchase&rdquo;. If you cannot find it, open the
          <a href={portalUrl} rel="noopener noreferrer">Polar customer portal</a> and look under Licence keys.
        </p>
      </li>
      <li>
        <strong>Activate it in {p.name}.</strong>
        <p>
          Open {p.name}&rsquo;s Options page, choose <b>Pro</b>, then <b>Enter licence key</b>. Paste the key and
          press <b>Activate</b>. The check takes a second and Pro features unlock immediately.
        </p>
      </li>
      <li>
        <strong>Use it on up to 3 browser profiles.</strong>
        <p>
          One key activates {p.name} Pro on up to three browser profiles. To move it, press <b>Deactivate</b> in the
          same dialog on the profile you are leaving; that frees the seat for another one.
        </p>
      </li>
    </ol>

    <section class="after" aria-labelledby="after-title">
      <h2 id="after-title">If something is off</h2>
      <p>
        Email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> for anything about your key, your order or a
        refund. Bugs and feature requests go on
        <a href={links.issues} rel="noopener">GitHub issues</a>, where everyone can see them. The
        <a href={supportUrl()}>support page</a> has the details.
      </p>
      <p class="back">
        <a class="btn ghost" href={productHome(p.slug)}>Back to {p.name}</a>
      </p>
    </section>
  </main>

  <Footer mode="absolute" />
</Base>

<script>
  // Display-only: Polar appends `?checkout_id=...` to the success URL. Read it
  // here so the buyer has a reference to quote in support email. Nothing is
  // sent anywhere.
  const id = new URLSearchParams(location.search).get('checkout_id');
  if (id && /^[A-Za-z0-9_-]{1,80}$/.test(id)) {
    const value = document.getElementById('order-ref-value');
    const wrap = document.getElementById('order-ref');
    if (value && wrap) {
      value.textContent = id;
      wrap.hidden = false;
    }
  }
</script>

<style>
  .thanks {
    padding-block: clamp(2.5rem, 6vw, 5rem) 0;
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-bottom: clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--rule);
  }
  h1 {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: clamp(2.25rem, 5vw, 4rem);
    max-width: 22ch;
  }
  .icon {
    color: var(--c);
    flex: none;
  }
  .lede {
    color: var(--ink-2);
    font-size: 1.125rem;
    max-width: 60ch;
  }
  .ref {
    text-transform: none;
    letter-spacing: 0.02em;
    font-size: 0.8125rem;
  }
  .ref span {
    color: var(--ink);
    user-select: all;
  }

  .steps {
    list-style: none;
    counter-reset: step;
    display: flex;
    flex-direction: column;
    max-width: 68ch;
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .steps li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 0.25rem 1rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .steps li::before {
    content: counter(step, decimal-leading-zero);
    grid-row: 1 / span 2;
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1;
    color: var(--c);
    font-variant-numeric: tabular-nums;
    padding-top: 0.15rem;
  }
  .steps strong {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.5rem;
    line-height: 1.1;
  }
  .steps p {
    grid-column: 2;
    color: var(--ink-2);
    font-size: 0.9875rem;
    margin-top: 0.4rem;
  }
  .steps b {
    font-weight: 600;
    color: var(--ink);
  }

  .after {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    max-width: 68ch;
  }
  .after h2 {
    font-size: clamp(1.75rem, 3vw, 2.375rem);
    margin-bottom: 1rem;
  }
  .after p {
    color: var(--ink-2);
  }
  .back {
    margin-top: 1.75rem;
  }
</style>
