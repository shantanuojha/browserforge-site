---
import Legal from './Legal.astro';
import SideNav from '../components/SideNav.astro';
import {
  BRAND,
  LICENCE_API_HOST,
  LICENCE_PROVIDER,
  LICENCE_PROVIDER_PRIVACY_URL,
  OWNER,
  PRIVACY_EFFECTIVE_DATE,
  PRIVACY_EMAIL,
  PRODUCT_LINKS,
} from '../config';
import { privacyUrl } from '../lib/links';
import type { Product } from '../data/products';

/**
 * Served from the product host (`arbor.shantanuojha.com/privacy`) by a Vercel
 * rewrite; the landing-host path `/privacy/arbor` only exists as the rewrite
 * target and redirects there. Every outbound link is therefore absolute.
 */
interface Props {
  product: Product;
}
const { product: p } = Astro.props;
const path = `/privacy/${p.slug}`;
const canonical = privacyUrl(p.slug);
const links = PRODUCT_LINKS[p.slug];

interface NetRow {
  destination: string;
  when: string;
  sent: string;
  stored: string;
}
const network: NetRow[] = [];
if (p.pro) {
  network.push({
    destination: `${LICENCE_PROVIDER} licence API (${LICENCE_API_HOST})`,
    when: 'Only when you enter a Pro licence key, and periodically afterwards to re-validate it (about once a week, and only if a key is stored).',
    sent: 'The licence key you typed and a random instance identifier generated by the extension. No browsing data, no tab or rule contents, no account information.',
    stored: 'Whether the key is valid, and the instance identifier, in local extension storage.',
  });
}
if (p.slug === 'reroute') {
  network.push({
    destination: 'Your browser vendor\u2019s sync service, through chrome.storage.sync',
    when: 'Only if you turn on cross-device rule sync (Pro).',
    sent: 'Your rules, allowlist and settings, encrypted and transported by the browser under your own browser account. BrowserForge has no access to this data.',
    stored: 'By your browser vendor, subject to their sync privacy terms; and locally on each device.',
  });
}

const hasOptionalPermissions = p.privacy.permissions.some((perm) => perm.kind === 'optional permission');

const sections = [
  { id: 'summary', label: 'Summary' },
  { id: 'scope', label: 'Scope' },
  { id: 'data', label: 'Data handled' },
  { id: 'storage', label: 'Where data lives' },
  { id: 'network', label: 'Network connections' },
  { id: 'permissions', label: 'Permissions explained' },
  { id: 'retention', label: 'Retention and deletion' },
  { id: 'sharing', label: 'Sharing and sale' },
  { id: 'limited-use', label: 'Limited Use' },
  { id: 'security', label: 'Security' },
  { id: 'children', label: 'Children' },
  { id: 'changes', label: 'Changes' },
  { id: 'contact', label: 'Contact' },
];
---

<Legal
  title={`${p.name} privacy policy`}
  description={`How the ${p.name} browser extension handles data. Short version: everything stays in your browser, and the only network calls are the ones listed here.`}
  path={path}
  canonical={canonical}
  mode="absolute"
  kicker={`${BRAND} / Privacy`}
  effective={PRIVACY_EFFECTIVE_DATE}
  current="privacy"
>
  <Fragment slot="aside">
    <SideNav title="Sections" items={sections.map((s) => ({ href: `#${s.id}`, label: s.label }))} />
    <div class="other">
      <span class="mono">Other policies</span>
      <ul>
        <li><a href={privacyUrl()}>All policies</a></li>
        {p.slug !== 'arbor' && <li><a href={privacyUrl('arbor')}>Arbor</a></li>}
        {p.slug !== 'reroute' && <li><a href={privacyUrl('reroute')}>Reroute</a></li>}
        {p.slug !== 'cookiesweep' && <li><a href={privacyUrl('cookiesweep')}>CookieSweep</a></li>}
      </ul>
    </div>
  </Fragment>

  <h2 id="summary">Summary</h2>
  <ul class="summary-list">
    <li>{p.name} stores its data in your browser&rsquo;s local extension storage. There is no {BRAND} server and no account.</li>
    <li>{p.name} contains no analytics, telemetry, crash reporting or advertising code.</li>
    {
      network.length === 0 ? (
        <li>{p.name} makes no network requests of any kind.</li>
      ) : (
        <li>
          {p.name} can make {network.length === 1 ? 'one kind' : `${network.length} kinds`} of network request, all
          optional and listed in full under <a href="#network">Network connections</a>.
        </li>
      )
    }
    <li>{p.name} never sells, rents or shares your data with anyone, because it never has it.</li>
    <li>Uninstalling {p.name} deletes all of its local data.</li>
  </ul>

  <h2 id="scope">Scope</h2>
  <p>
    This policy covers the {p.name} browser extension for Chrome and Edge, published by {OWNER} under the {BRAND}
    name (&ldquo;we&rdquo;, &ldquo;us&rdquo;). It applies to every version of {p.name} distributed through the
    Chrome Web Store, Microsoft Edge Add-ons, or built from the source at
    <a href={links.source} rel="noopener">GitHub</a>.
  </p>
  <p>
    This website ({BRAND} pages on shantanuojha.com and its subdomains) sets no cookies, runs no analytics and
    loads no third-party scripts or fonts. Hosting is provided by Vercel, whose edge servers see the usual request
    metadata (IP address, user agent) in order to serve pages; we do not enable Vercel&rsquo;s analytics products.
  </p>

  <h2 id="data">Data handled</h2>
  <p>To do its job, {p.name} handles the following data. All of it stays on your device unless a row in the network table says otherwise.</p>
  <ul>
    {p.privacy.dataHandled.map((d) => <li>{d}</li>)}
  </ul>

  <h2 id="storage">Where data lives</h2>
  <p>
    {p.name} uses the browser&rsquo;s extension storage (<code>chrome.storage.local</code>
    {p.slug === 'reroute' && <>, and <code>chrome.storage.sync</code> if you enable Pro sync</>})
    {
      p.slug === 'arbor' ? (
        <>
          {' '}and IndexedDB inside the extension&rsquo;s own origin, where the tree, its snapshots and any scheduled
          backups are kept.
        </>
      ) : (
        <> and, where noted, IndexedDB inside the extension&rsquo;s own origin.</>
      )
    }
    {' '}This storage is isolated from websites and from other extensions, and it stays on your computer. It is not
    readable by us. We operate no database, no backend and no account system.
  </p>

  <h2 id="network">Network connections</h2>
  {
    network.length === 0 ? (
      <p>
        {p.name} makes <strong>no network requests</strong>. It has no licence check, no rule or list download, no
        update feed and no telemetry. The extension package is updated only through the browser&rsquo;s store
        mechanism, which is operated by the browser vendor.
      </p>
    ) : (
      <>
        <p>
          The complete list of destinations {p.name} can contact is below. Each one is optional and off until you
          turn the corresponding feature on.
        </p>
        <div class="table-wrap">
          <table class="table">
            <thead>
              <tr>
                <th>Destination</th>
                <th>When</th>
                <th>What is sent</th>
                <th>What is stored</th>
              </tr>
            </thead>
            <tbody>
              {network.map((n) => (
                <tr>
                  <td>{n.destination}</td>
                  <td>{n.when}</td>
                  <td>{n.sent}</td>
                  <td>{n.stored}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )
  }
  <ul>
    {p.privacy.network.map((n) => <li>{n}</li>)}
  </ul>
  {
    p.pro && (
      <p>
        {LICENCE_PROVIDER} is our merchant of record for Pro licences. When you buy a licence, your payment details
        and email address are handled by {LICENCE_PROVIDER} under
        <a href={LICENCE_PROVIDER_PRIVACY_URL} rel="noopener">
          its privacy policy
        </a>
        . The extension itself never sees your payment details or your email address.
      </p>
    )
  }

  <h2 id="permissions">Permissions explained</h2>
  <p>
    Every permission in the {p.name} manifest is listed here with the reason it is needed.
    {
      hasOptionalPermissions && (
        <>
          {' '}Optional permissions are requested only when you enable the corresponding feature and can be revoked
          from the extension&rsquo;s details page in your browser.
        </>
      )
    }
  </p>
  <div class="table-wrap">
    <table class="table perms">
      <thead>
        <tr>
          <th>Permission</th>
          <th>Type</th>
          <th>Why {p.name} needs it</th>
        </tr>
      </thead>
      <tbody>
        {
          p.privacy.permissions.map((perm) => (
            <tr>
              <td>
                <code>{perm.name}</code>
              </td>
              <td class="kind">{perm.kind}</td>
              <td>{perm.why}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2 id="retention">Retention and deletion</h2>
  <ul>
    {p.privacy.retention.map((r) => <li>{r}</li>)}
    <li>
      You can delete everything at once by removing the extension. Chrome and Edge delete an extension&rsquo;s
      local storage on uninstall.
    </li>
  </ul>

  <h2 id="sharing">Sharing and sale</h2>
  <p>
    We do not sell, rent, trade or otherwise share your data with third parties, and we do not use it for
    advertising, profiling or training. We cannot: {p.name} does not send your data to us. The only third parties
    that can receive data from {p.name} are the ones you choose to connect in the
    <a href="#network">network table</a> above, and each of those receives only what that row describes.
  </p>

  <h2 id="limited-use">Limited Use</h2>
  <p>
    {p.name}&rsquo;s use of information received from Google APIs, including Chrome extension APIs, adheres to the
    <a href="https://developer.chrome.com/docs/webstore/program-policies/user-data-faq" rel="noopener">
      Chrome Web Store User Data Policy
    </a>
    , including its Limited Use requirements. Specifically:
  </p>
  <ul>
    <li>Data is used only to provide or improve the user-facing features described on the {p.name} listing and product page.</li>
    <li>Data is not transferred to anyone except as necessary to provide those features, to comply with law, or as part of a merger or acquisition with prior notice to users.</li>
    <li>Data is never used or transferred to serve advertisements, to determine credit-worthiness or for lending purposes.</li>
    <li>No human reads your data, because it never leaves your device.</li>
  </ul>
  {
    p.slug === 'arbor' && (
      <p>
        The current version of {p.name} does not use the Google Drive API and does not request the
        <code>identity</code> permission. If a future version adds the planned Google Drive backup, it will request
        <code>identity</code> only when you enable that feature, will use the <code>drive.file</code> scope solely
        to read and write {p.name}&rsquo;s own backup files in your Drive, and its use of information received from
        the Google Drive API will adhere to the same Limited Use requirements. This policy will be updated before
        that version is published.
      </p>
    )
  }

  <h2 id="security">Security</h2>
  <p>
    Extension storage is protected by the browser&rsquo;s process isolation and your operating system&rsquo;s user
    account. Backup files you export are ordinary files; protect them as you would any other document that lists
    the sites you visit. Network connections listed above use HTTPS. The source code is public, so anyone can
    check that the extension does what this policy says. If you find a discrepancy, please report it (see
    <a href="#contact">Contact</a>).
  </p>

  <h2 id="children">Children</h2>
  <p>
    {p.name} is a general-purpose tool and is not directed at children under 13 (or the age of digital consent in
    your jurisdiction). We do not knowingly collect any personal information from anyone, including children. If
    you believe a child has provided us with personal information by email, contact us and we will delete it.
  </p>

  <h2 id="changes">Changes to this policy</h2>
  <p>
    If this policy changes, the new version is published at this address with a new effective date, and the change
    is noted in the {p.name} release notes. If a change would let {p.name} send new categories of data anywhere, we
    will describe it in the extension&rsquo;s update notes and, where the browser supports it, ask for the new
    permission explicitly. The history of this document is in the
    <a href="https://github.com/shantanuojha/browserforge-site" rel="noopener">website repository</a>.
  </p>

  <h2 id="contact">Contact</h2>
  <p>
    {OWNER}<br />
    <a href={`mailto:${PRIVACY_EMAIL}`}>{PRIVACY_EMAIL}</a><br />
    Security or privacy concerns can also be filed as a <a href={links.issues} rel="noopener">GitHub issue</a>, or
    by email if they should not be public.
  </p>
</Legal>

<style>
  .summary-list {
    border: 1px solid var(--rule-strong);
    border-left: 4px solid var(--accent);
    padding: 1.25rem 1.25rem 1.25rem 2.25rem;
    background: color-mix(in srgb, var(--paper-2) 60%, transparent);
  }
  .other {
    margin-top: 2rem;
    border-top: 1px solid var(--rule-strong);
    padding-top: 0.9rem;
  }
  .other ul {
    list-style: none;
    margin-top: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    font-size: 0.9rem;
  }
  .other a {
    text-decoration: none;
    color: var(--ink-2);
  }
  .other a:hover {
    text-decoration: underline;
    color: var(--ink);
  }
  .perms td:first-child {
    width: 28%;
  }
  .kind {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--ink-3);
    white-space: nowrap;
  }
</style>
